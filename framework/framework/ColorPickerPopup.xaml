<UserControl x:Class="framework.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Border Background="#1E1E1E" CornerRadius="8"
            BorderBrush="#444" BorderThickness="1"
            Effect="{x:Null}">
            <StackPanel Margin="12">

                <!-- ===== SV 色盤 ===== -->
                <Grid Height="160" Margin="0,0,0,10" Cursor="Cross">
                    <!-- 白→純色 水平漸層 -->
                    <Canvas Name="SvCanvas" ClipToBounds="True">
                        <!-- 漸層由 code-behind 動態更新 -->
                        <Rectangle Name="SvBase" Canvas.Left="0" Canvas.Top="0" RadiusX="5" RadiusY="5"/>
                        <Rectangle Name="SvWhite" Canvas.Left="0" Canvas.Top="0" RadiusX="5" RadiusY="5"/>
                        <Rectangle Name="SvBlack" Canvas.Left="0" Canvas.Top="0" RadiusX="5" RadiusY="5"/>

                        <!-- 游標圓圈 -->
                        <Ellipse Name="SvCursor"
                                 Width="14" Height="14"
                                 Stroke="White" StrokeThickness="2"
                                 Fill="Transparent"
                                 IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4"
                                                  ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>

                    <!-- 滑鼠事件覆蓋層 -->
                    <Rectangle Fill="Transparent" RadiusX="5" RadiusY="5"
                               MouseLeftButtonDown="SvArea_MouseDown"
                               MouseMove="SvArea_MouseMove"
                               MouseLeftButtonUp="SvArea_MouseUp"/>
                </Grid>

                <!-- ===== 色相 Slider ===== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="H" Foreground="#888"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Height="14">
                        <Rectangle RadiusX="7" RadiusY="7" Name="HueBarBg">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.167"/>
                                    <GradientStop Color="#00FF00" Offset="0.333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.833"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas Name="HueCanvas" Background="Transparent"
                                MouseLeftButtonDown="HueBar_MouseDown"
                                MouseMove="HueBar_MouseMove"
                                MouseLeftButtonUp="HueBar_MouseUp">
                            <Ellipse Name="HueThumb"
                                     Width="18" Height="18" Canvas.Top="-2"
                                     Fill="White" Stroke="#333" StrokeThickness="1.5"
                                     IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- ===== 透明度 Slider ===== -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="A" Foreground="#888"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Height="14">
                        <!-- 棋盤格背景（透明效果） -->
                        <Rectangle RadiusX="7" RadiusY="7" Name="AlphaBgCheck">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,8,8"
                                             ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#CCCCCC">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,8,8"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,4,4"/>
                                                        <RectangleGeometry Rect="4,4,4,4"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- 透明→純色 漸層（動態） -->
                        <Rectangle RadiusX="7" RadiusY="7" Name="AlphaGradRect"/>
                        <Canvas Name="AlphaCanvas" Background="Transparent"
                                MouseLeftButtonDown="AlphaBar_MouseDown"
                                MouseMove="AlphaBar_MouseMove"
                                MouseLeftButtonUp="AlphaBar_MouseUp">
                            <Ellipse Name="AlphaThumb"
                                     Width="18" Height="18" Canvas.Top="-2"
                                     Fill="White" Stroke="#333" StrokeThickness="1.5"
                                     IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- ===== RGB 數值輸入 + 預覽 ===== -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <!-- R -->
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="R" Foreground="#888" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtR" Text="255"
                                 Background="#2A2A2A" Foreground="White"
                                 BorderBrush="#555" BorderThickness="1"
                                 TextAlignment="Center" FontSize="12" Padding="2"
                                 TextChanged="RgbInput_Changed"/>
                    </StackPanel>
                    <!-- G -->
                    <StackPanel Grid.Column="1" Margin="0,0,4,0">
                        <TextBlock Text="G" Foreground="#888" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtG" Text="255"
                                 Background="#2A2A2A" Foreground="White"
                                 BorderBrush="#555" BorderThickness="1"
                                 TextAlignment="Center" FontSize="12" Padding="2"
                                 TextChanged="RgbInput_Changed"/>
                    </StackPanel>
                    <!-- B -->
                    <StackPanel Grid.Column="2" Margin="0,0,4,0">
                        <TextBlock Text="B" Foreground="#888" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtB" Text="255"
                                 Background="#2A2A2A" Foreground="White"
                                 BorderBrush="#555" BorderThickness="1"
                                 TextAlignment="Center" FontSize="12" Padding="2"
                                 TextChanged="RgbInput_Changed"/>
                    </StackPanel>
                    <!-- A% -->
                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                        <TextBlock Text="A%" Foreground="#888" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox Name="TxtA" Text="100"
                                 Background="#2A2A2A" Foreground="White"
                                 BorderBrush="#555" BorderThickness="1"
                                 TextAlignment="Center" FontSize="12" Padding="2"
                                 TextChanged="AlphaInput_Changed"/>
                    </StackPanel>
                    <!-- 顏色預覽方塊 -->
                    <Border Grid.Column="4" Name="PreviewBox"
                            Width="40" Height="40" CornerRadius="5"
                            BorderBrush="#555" BorderThickness="1">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8"
                                         ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#CCCCCC">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,8,8"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FFFFFF">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,4,4"/>
                                                    <RectangleGeometry Rect="4,4,4,4"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- 預覽方塊疊加實際顏色層 -->
                <Border Name="PreviewColorOverlay"
                        CornerRadius="5" Height="0" Margin="0,-48,0,0"
                        HorizontalAlignment="Right" Width="40"
                        IsHitTestVisible="False"/>

                <!-- ===== Hex 輸入 ===== -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Foreground="#888"
                               FontSize="13" VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1" Name="TxtHex"
                             Background="#2A2A2A" Foreground="White"
                             BorderBrush="#555" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12"
                             Padding="6,4" CharacterCasing="Upper"
                             MaxLength="8"
                             TextChanged="HexInput_Changed"/>
                </Grid>

                <!-- ===== 常用色票 ===== -->
                <TextBlock Text="常用色票" Foreground="#888" FontSize="10"
                           Margin="0,0,0,6"/>
                <WrapPanel Name="SwatchPanel" Margin="0,0,0,10"/>

                <!-- ===== 套用按鈕 ===== -->
                <Button Name="BtnApply" Content="✔ 套用顏色"
                        Background="#007ACC" Foreground="White"
                        BorderBrush="{x:Null}" Padding="0,8"
                        FontWeight="SemiBold"
                        Click="BtnApply_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
