<Window x:Class="framework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:framework"
        Title="VideoMaster 2026 剪輯軟體"
        WindowState="Maximized"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        InputMethod.IsInputMethodEnabled="False">
    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="3,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A4A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D6EBF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5D8EDF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LivePreviewToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="#555555"
                                BorderBrush="#777777"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A5A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E7D32"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#388E3C"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Name="MainRootGrid" Focusable="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>

        <!-- ===== 工具列 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#333333" VerticalAlignment="Center">
            <Button Name="BtnImport" Content="📁 匯入影片" Margin="15,0,5,0" Padding="15,5"
                    Background="White" Click="BtnImport_Click"/>
            <Button Name="BtnImportAudio" Content="🎵 匯入音訊" Margin="5,0,0,0" Padding="15,5"
                    Background="#2E5A2E" Foreground="White" BorderBrush="{x:Null}" Click="BtnImportAudio_Click"/>
            <Button Name="BtnExport" Content="🎬 輸出影片" Margin="5,0,0,0" Padding="15,5"
                    Background="#007ACC" Foreground="White" BorderBrush="{x:Null}" Click="BtnExport_Click"/>
            <Separator Margin="10,5" Background="#555"/>
            <Button Name="BtnPreviewSubtitle" Content="👁 預覽字卡" Margin="5,0,0,0" Padding="15,5"
                    Background="#5A3E8A" Foreground="White" BorderBrush="{x:Null}" Click="BtnPreviewSubtitle_Click"/>
            <Button Name="BtnHidePreview" Content="✖ 關閉預覽" Margin="5,0,0,0" Padding="15,5"
                    Background="#555" Foreground="White" BorderBrush="{x:Null}" Click="BtnHidePreview_Click"/>
        </StackPanel>

        <!-- ===== 中區：播放器 + 設定面板 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- 影片播放區 -->
            <Grid Grid.Column="0" Margin="10">
                <Border Background="Black">
                    <Grid>
                        <MediaElement Name="VideoPlayer"
                          ScrubbingEnabled="True"
                          LoadedBehavior="Manual"
                          Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened"/>
                        <Rectangle x:Name="BlackScreenGap" Fill="Black" Visibility="Collapsed"/>
                        <Canvas Name="SubtitleOverlayCanvas" IsHitTestVisible="True"
                                Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右側設定面板 -->
            <TabControl x:Name="MainTabControl" Grid.Column="1" Margin="10">

                <!-- ===== 字卡設定頁 ===== -->
                <TabItem Header="📝 字卡設定 (F1)" FontSize="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10,12,12">

                            <!-- 字卡文字 -->
                            <TextBlock Text="字卡文字" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtSubtitle" Height="58" TextWrapping="Wrap"
                                     AcceptsReturn="True" Padding="6" FontSize="13"
                                     Margin="0,0,0,12"
                                     VerticalScrollBarVisibility="Auto"/>

                            <Separator Margin="0,0,0,10"/>

                            <!-- 字體 -->
                            <TextBlock Text="字體" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox Name="ComboFontFamily" Margin="0,0,0,7"
                                      SelectionChanged="StyleControl_Changed">
                                <ComboBoxItem Content="微軟正黑體" IsSelected="True"/>
                                <ComboBoxItem Content="新細明體"/>
                                <ComboBoxItem Content="標楷體"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Consolas"/>
                            </ComboBox>

                            <!-- 大小 + 粗細 同行 -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="大小" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="TxtFontSize" Grid.Column="1" Text="24" Padding="5,3"
                                         TextChanged="StyleControl_TextChanged"/>
                                <TextBlock Grid.Column="3" Text="粗細" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox Name="ComboFontWeight" Grid.Column="4"
                                          SelectionChanged="StyleControl_Changed">
                                    <ComboBoxItem Content="一般" IsSelected="True"/>
                                    <ComboBoxItem Content="粗體"/>
                                    <ComboBoxItem Content="細體"/>
                                    <ComboBoxItem Content="特粗"/>
                                </ComboBox>
                            </Grid>

                            <!-- 斜體 + 底線 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Name="ChkItalic" Content="斜體"
                                          VerticalAlignment="Center" Margin="0,0,20,0"
                                          Checked="StyleControl_CheckChanged" Unchecked="StyleControl_CheckChanged"/>
                                <CheckBox Name="ChkUnderline" Content="底線"
                                          VerticalAlignment="Center"
                                          Checked="StyleControl_CheckChanged" Unchecked="StyleControl_CheckChanged"/>
                            </StackPanel>

                            <Separator Margin="0,0,0,10"/>

                            <!-- 顏色 -->
                            <TextBlock Text="顏色  （點擊色塊開啟調色盤）" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,7">

                                <StackPanel Margin="0,0,5,5">
                                    <TextBlock Text="字體" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="30" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#CCCCCC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
                                        </Border>
                                        <Border x:Name="FontColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="White"/>
                                        <Button Name="BtnPickFontColor" Background="Transparent" BorderBrush="Transparent" Click="BtnPickFontColor_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="陰影" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="30" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#CCCCCC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
                                        </Border>
                                        <Border x:Name="ShadowColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="Black"/>
                                        <Button Name="BtnPickShadowColor" Background="Transparent" BorderBrush="Transparent" Click="BtnPickShadowColor_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="外框" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="30" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#CCCCCC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
                                        </Border>
                                        <Border x:Name="BorderColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="Black"/>
                                        <Button Name="BtnPickBorderColor" Background="Transparent" BorderBrush="Transparent" Click="BtnPickBorderColor_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="背景" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="30" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#CCCCCC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
                                        </Border>
                                        <Border x:Name="BgColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="Transparent"/>
                                        <Button Name="BtnPickBgColor" Background="Transparent" BorderBrush="Transparent" ToolTip="透明 = A 設為 0" Click="BtnPickBgColor_Click"/>
                                    </Grid>
                                </StackPanel>

                            </UniformGrid>

                            <!-- 外框寬度 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="外框寬度" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Name="SliderStroke" Grid.Column="1" Minimum="0" Maximum="10" Value="0"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="StyleControl_SliderChanged"/>
                                <TextBlock Grid.Column="2" Name="LblStrokeValue" Text="0"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="Bold" FontSize="12"/>
                            </Grid>

                            <Separator Margin="0,0,0,10"/>

                            <!-- 位置 -->
                            <TextBlock Text="位置" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox Name="ComboPosition" Margin="0,0,0,7"
                                      SelectionChanged="StyleControl_Changed">
                                <ComboBoxItem Content="底部置中" IsSelected="True"/>
                                <ComboBoxItem Content="頂部置中"/>
                                <ComboBoxItem Content="中央置中"/>
                                <ComboBoxItem Content="底部靠左"/>
                                <ComboBoxItem Content="底部靠右"/>
                            </ComboBox>

                            <!-- X / Y 座標 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="TxtPosX" Grid.Column="1" Text="0" Padding="5,3"
                                         IsReadOnly="True" Background="#F0F0F0" ToolTip="拖曳字卡後自動更新"/>
                                <TextBlock Grid.Column="3" Text="Y" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="TxtPosY" Grid.Column="4" Text="0" Padding="5,3"
                                         IsReadOnly="True" Background="#F0F0F0" ToolTip="拖曳字卡後自動更新"/>
                            </Grid>

                            <Separator Margin="0,0,0,10"/>

                            <!-- 出現時間 -->
                            <TextBlock Text="出現時間" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="開始" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="TxtSubStartTime" Grid.Column="1" Text="0" Padding="5,3"/>
                                <TextBlock Grid.Column="3" Text="時長" FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="TxtSubDuration" Grid.Column="4" Text="5" Padding="5,3"/>
                            </Grid>

                            <!-- 預覽縮圖 -->
                            <Border Background="#111" CornerRadius="6" Height="68"
                                    ClipToBounds="True" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="字卡預覽" Foreground="#555" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Name="MiniPreviewBorder" CornerRadius="3" Padding="8,3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Name="TxtMiniPreview" Text="字卡預覽文字"
                                                   Foreground="White" FontSize="14"
                                                   FontFamily="Microsoft JhengHei"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 操作按鈕 -->
                            <Button Content="➕ 套用字卡至時間軸"
                                    Padding="8,10" Background="#007ACC" Foreground="White"
                                    BorderBrush="{x:Null}" Margin="0,0,0,6"
                                    FontWeight="SemiBold" Click="BtnAddText_Click"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="💾 更新選取樣式"
                                        Padding="8,8" Background="#5A8A3E" Foreground="White"
                                        BorderBrush="{x:Null}" Margin="0,0,4,0"
                                        FontWeight="SemiBold" Click="BtnUpdateStyle_Click"/>
                                <Button Grid.Column="1" Content="👁 即時預覽"
                                        Padding="8,8" Background="#5A3E8A" Foreground="White"
                                        BorderBrush="{x:Null}" Margin="4,0,0,0"
                                        FontWeight="SemiBold" Click="BtnPreviewSubtitle_Click"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 影像剪輯頁 ===== -->
                <TabItem Header="✂️ 影像剪輯 (F2)" FontSize="14">
                    <StackPanel Margin="15">
                        <TextBlock Text="✂️ 剪輯設定面板" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                        <TextBlock Text="設定剪輯保留區間：" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="開始時間 (秒)：" VerticalAlignment="Center" Width="100"/>
                            <TextBox Name="TxtStartTime" Width="70" Text="0" 
                                     VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="結束時間 (秒)：" VerticalAlignment="Center" Width="100"/>
                            <TextBox Name="TxtEndTime" Width="70" Text="10" 
                                     VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>

                        <Button Name="BtnTrim" Content="設定剪輯標記" Padding="10"
                                Background="#007ACC" Foreground="White" BorderBrush="{x:Null}"
                                Click="BtnTrim_Click"/>
                    </StackPanel>
                </TabItem>

                <!-- ===== 畫面調整頁 ===== -->
                <TabItem Header="🎨 畫面調整 (F3)" FontSize="14">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="此區塊未來可放置亮度、對比、濾鏡等設定..." 
                                   Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- ===== 時間軸區域 ===== -->
        <Border Grid.Row="2" Background="#252526" Margin="10,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2D2D2D">
                    <Button Name="BtnPlay" Content="▶ 播放" Margin="5" Padding="15,2" 
                            Background="#4CAF50" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="BtnPlay_Click"/>
                    <Button Name="BtnPause" Content="⏸ 暫停" Margin="0,5,15,5" Padding="15,2" 
                            Background="#FF9800" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="BtnPause_Click"/>

                    <RadioButton Name="RadioSelect" IsChecked="True"
                                 Checked="ToolRadioButton_Checked" Tag="Select"
                                 Style="{StaticResource ToolButtonStyle}"
                                 VerticalAlignment="Center"
                                 ToolTip="左鍵點擊選取單一元素；右鍵拖曳框選多個元素">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↖" FontSize="17" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="選取" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="(V)" FontSize="9" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Name="RadioScissors"
                                 Checked="ToolRadioButton_Checked" Tag="Scissors"
                                 Style="{StaticResource ToolButtonStyle}"
                                 VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✂" FontSize="17" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="剪刀" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="(C)" FontSize="9" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <ToggleButton x:Name="BtnLivePreview"
                                 Margin="5,3" Style="{StaticResource LivePreviewToggleStyle}"
                                 VerticalAlignment="Center"
                                 Click="BtnLivePreview_Click"
                                 ToolTip="開啟後，滑鼠懸停於時間軸時預覽視窗將即時跟隨游標位置">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👁" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="即時預覽" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="(hover)" FontSize="9" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="BtnDelete" Content="✖ 刪除 (Del)" 
                            Click="BtnDelete_Click" 
                            Margin="10,5,5,5" Padding="10,0" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand"/>
                    <Button x:Name="BtnUndo" Content="↩ 撤銷 (Ctrl+Z)" 
                            Click="BtnUndo_Click" 
                            Margin="5,5,5,5" Padding="10,0" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" ToolTip="復原上一個動作"/>
                    <Button x:Name="BtnRedo" Content="↪ 重作 (Ctrl+Y)" 
                            Click="BtnRedo_Click" 
                            Margin="5,5,10,5" Padding="10,0" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" ToolTip="重做上一個動作"/>
                    <Separator Margin="0,5,0,5" Background="#555"/>
                    <Button x:Name="BtnCut" Content="✂ 剪下 (Ctrl+X)"
                            Click="BtnCut_Click"
                            Margin="5,5,5,5" Padding="10,0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="剪下選取的元素"/>
                    <Button x:Name="BtnCopy" Content="⎘ 複製 (Ctrl+C)"
                            Click="BtnCopy_Click"
                            Margin="5,5,5,5" Padding="10,0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="複製選取的元素"/>
                    <Button x:Name="BtnPaste" Content="📋 貼上 (Ctrl+V)"
                            Click="BtnPaste_Click"
                            Margin="5,5,10,5" Padding="10,0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="貼上至游標右方"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" x:Name="TimelineScrollViewer" 
                              PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Background="Transparent"
                                MouseDown="VideoTrackCanvas_MouseDown"
                                MouseMove="TimelineArea_MouseMove"
                                MouseLeave="TimelineArea_MouseLeave"
                                MouseUp="TimelineArea_MouseUp"
                                ContextMenuOpening="TimelineArea_ContextMenuOpening">

                        <Grid Name="TimelineContentStack">
                            <StackPanel Orientation="Vertical">

                                <Grid Height="25" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Grid.Column="1" Name="TimeRulerCanvas" 
                    Background="#2D2D2D" HorizontalAlignment="Left"/>
