<Window x:Class="framework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoMaster 2026 剪輯軟體"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#333333" VerticalAlignment="Center">
            <Button Name="BtnImport" Content="📁 匯入影片" Margin="15,0,5,0" Padding="15,5" Background="White" Click="BtnImport_Click"/>
            <Button Name="BtnExport" Content="🎬 輸出影片" Margin="5,0,0,0" Padding="15,5" Background="#007ACC" Foreground="White" BorderBrush="{x:Null}" Click="BtnExport_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10">
                <Border Background="Black">
                    <Grid>
                            <MediaElement Name="VideoPlayer"
                                  ScrubbingEnabled="True"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"/>

                            <Canvas IsHitTestVisible="False">
                            <TextBlock Name="TxtPreview" 
                                   Text="字卡預覽" 
                                   Foreground="White" 
                                   FontSize="24"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                            </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <TabControl x:Name="MainTabControl" Grid.Column="1" Margin="10">

                <TabItem Header="📝 字卡設定(F1)" FontSize="14">
                    <StackPanel Margin="15">
                        <TextBlock Text="🎬 字卡設定面板" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                        <TextBlock Text="請輸入字幕內容：" Margin="0,0,0,5"/>
                        <TextBox Name="TxtSubtitle" Height="40" TextWrapping="Wrap" Margin="0,0,0,15" AcceptsReturn="True"/>
                        <TextBlock Text="字體："/>
                        <ComboBox Name="ComboFontFamily" Margin="0,5,0,10">
                            <ComboBoxItem Content="微軟正黑體" IsSelected="True"/>
                            <ComboBoxItem Content="新細明體"/>
                            <ComboBoxItem Content="標楷體"/>
                        </ComboBox>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="字體大小："/>
                                <TextBox Name="TxtFontSize" Text="24" Margin="0,5"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="字體粗細："/>
                                <ComboBox Name="ComboFontWeight" Margin="0,5">
                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                    <ComboBoxItem Content="Bold"/>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="字體顏色 (Hex)：" Margin="0,5,0,0"/>
                        <TextBox Name="TxtFontColor" Text="#FFFFFF" Margin="0,5"/>

                        <TextBlock Text="外框寬度：" Margin="0,5,0,0"/>
                        <Slider Name="SliderStroke" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                Content="💾 更新所選字卡樣式"
                                Padding="10"
                                Background="#007ACC"
                                Foreground="White"
                                Click="BtnUpdateStyle_Click"
                                Margin="0,0,5,0"/>

                            <Button Grid.Column="1"
                                Content="套用字卡設定"
                                Padding="8"
                                Click="BtnAddText_Click"
                                Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <TabItem Header="✂️ 影像剪輯 (F2)" FontSize="14">
                    <StackPanel Margin="15">
                        <TextBlock Text="✂️ 剪輯設定面板" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                        <TextBlock Text="設定剪輯保留區間：" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="開始時間 (秒)：" VerticalAlignment="Center" Width="100"/>
                            <TextBox Name="TxtStartTime" Width="60" Text="0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="結束時間 (秒)：" VerticalAlignment="Center" Width="100"/>
                            <TextBox Name="TxtEndTime" Width="60" Text="10" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Button Name="BtnTrim" Content="設定剪輯標記" Padding="8" Click="BtnTrim_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="🎨 畫面調整 (F3)" FontSize="14">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="此區塊未來可放置亮度、對比、濾鏡等設定..." Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#252526" Margin="10,0,10,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Background="Transparent" MouseDown="VideoTrackCanvas_MouseDown">

                    <StackPanel Orientation="Horizontal" Background="#2D2D2D">
                        <Button Name="BtnPlay" Content="▶ 播放" Margin="5" Padding="15,2" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnPlay_Click"/>
                        <Button Name="BtnPause" Content="⏸ 暫停" Margin="0,5,15,5" Padding="15,2" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnPause_Click"/>
                        
                        <RadioButton Name="ToolSelect" Content="🏹 選取 (V)" IsChecked="True" Margin="5" Foreground="White" VerticalAlignment="Center"/>
                        <RadioButton Name="ToolRazor" Content="✂️ 剪刀 (C)" Margin="5" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="BtnDelete" Content="✖ 刪除 (Del)" Click="BtnDelete_Click" 
                                Margin="10,5,5,5" Padding="10,0" 
                                Background="Transparent" Foreground="White" BorderThickness="0" 
                                Cursor="Hand"/>
                    </StackPanel>

                    <Grid Name="TimelineContentStack">
                        <StackPanel Orientation="Vertical">

                            <Grid Height="25" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Canvas Grid.Column="1" Name="TimeRulerCanvas" Background="#2D2D2D" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Height="120" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="207*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🎬 影像軌" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Canvas Grid.Column="1" Name="VideoTrackCanvas" Background="#1E1E1E" HorizontalAlignment="Left" Grid.ColumnSpan="2"/>
                            </Grid>
                        </StackPanel>

                        <Canvas Name="PlayheadCanvas" IsHitTestVisible="False" Margin="80,0,0,0" Panel.ZIndex="1">
                            <Line x:Name="PlayheadLine" 
                          X1="0"  Y1="0" X2="0"  Y2="120"   
                          Stroke="Red" 
                          StrokeThickness="2" 
                          Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>