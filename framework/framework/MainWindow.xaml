<Window x:Class="framework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:framework"
        Title="VideoMaster 2026 剪輯軟體"
        WindowState="Maximized"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        InputMethod.IsInputMethodEnabled="False">
    <Grid Name="MainRootGrid" Focusable="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>

        <!-- ===== 工具列 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#333333" VerticalAlignment="Center">
            <Button Name="BtnImport" Content="📁 匯入影片" Margin="15,0,5,0" Padding="15,5" 
                    Background="White" Click="BtnImport_Click"/>
            <Button Name="BtnExport" Content="🎬 輸出影片" Margin="5,0,0,0" Padding="15,5" 
                    Background="#007ACC" Foreground="White" BorderBrush="{x:Null}" Click="BtnExport_Click"/>
            <Separator Margin="10,5" Background="#555"/>
            <Button Name="BtnPreviewSubtitle" Content="👁 預覽字卡" Margin="5,0,0,0" Padding="15,5"
                    Background="#5A3E8A" Foreground="White" BorderBrush="{x:Null}" Click="BtnPreviewSubtitle_Click"/>
            <Button Name="BtnHidePreview" Content="✖ 關閉預覽" Margin="5,0,0,0" Padding="15,5"
                    Background="#555" Foreground="White" BorderBrush="{x:Null}" Click="BtnHidePreview_Click"/>
        </StackPanel>

        <!-- ===== 中區：播放器 + 設定面板 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- 影片播放區 -->
            <Grid Grid.Column="0" Margin="10">
                <Border Background="Black">
                    <Grid>
                        <MediaElement Name="VideoPlayer"
                          ScrubbingEnabled="True"
                          LoadedBehavior="Manual"
                          Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened"/>
                        <Rectangle x:Name="BlackScreenGap" Fill="Black" Visibility="Collapsed"/>
                        <Canvas Name="SubtitleOverlayCanvas" IsHitTestVisible="True"
                                Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右側設定面板 -->
            <TabControl x:Name="MainTabControl" Grid.Column="1" Margin="10">

                <!-- ===== 字卡設定頁 ===== -->
                <TabItem Header="📝 字卡設定 (F1)" FontSize="14">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="12">

                            <TextBlock Text="🎬 字卡設定面板" FontWeight="Bold" FontSize="15"
                                       Margin="0,0,0,12" Foreground="#1C1C1C"/>

                            <!-- 字幕內容 -->
                            <TextBlock Text="字幕內容：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtSubtitle" Height="55" TextWrapping="Wrap"
                                     AcceptsReturn="True" Margin="0,0,0,10"
                                     Padding="6" FontSize="13"
                                     VerticalScrollBarVisibility="Auto"/>

                            <!-- 字體選擇 -->
                            <TextBlock Text="字體（Font Family）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Name="ComboFontFamily" Margin="0,0,0,10"
                                      SelectionChanged="StyleControl_Changed">
                                <ComboBoxItem Content="微軟正黑體" IsSelected="True"/>
                                <ComboBoxItem Content="新細明體"/>
                                <ComboBoxItem Content="標楷體"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Consolas"/>
                            </ComboBox>

                            <!-- 大小 & 粗細 -->
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="字體大小（Size）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtFontSize" Text="24" Padding="5"
                                             TextChanged="StyleControl_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="字體粗細（Weight）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox Name="ComboFontWeight" SelectionChanged="StyleControl_Changed">
                                        <ComboBoxItem Content="Normal" IsSelected="True"/>
                                        <ComboBoxItem Content="Bold"/>
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="ExtraBold"/>
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <!-- 斜體 & 底線 -->
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <CheckBox Name="ChkItalic" Content="斜體（Italic）"
                                          VerticalAlignment="Center" Margin="0,0,5,0"
                                          Checked="StyleControl_CheckChanged" Unchecked="StyleControl_CheckChanged"/>
                                <CheckBox Name="ChkUnderline" Content="底線（Underline）"
                                          VerticalAlignment="Center" Margin="5,0,0,0"
                                          Checked="StyleControl_CheckChanged" Unchecked="StyleControl_CheckChanged"/>
                            </UniformGrid>

                            <!-- ── 顏色區：2×2 色塊按鈕格 ── -->
                            <TextBlock Text="顏色設定（點擊色塊開啟調色盤）："
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0,0,0,10" Rows="2">

                                <!-- 字體顏色 -->
                                <StackPanel Margin="0,0,6,6">
                                    <TextBlock Text="字體顏色" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <!-- 三層疊：棋盤格底層 / 顏色 Border（Window NameScope）/ 透明按鈕攔截點擊 -->
                                    <Grid Height="36" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <DrawingGroup>
                                                                <GeometryDrawing Brush="#CCCCCC">
                                                                    <GeometryDrawing.Geometry>
                                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                                <GeometryDrawing Brush="#FFFFFF">
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <RectangleGeometry Rect="0,0,4,4"/>
                                                                            <RectangleGeometry Rect="4,4,4,4"/>
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingGroup>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <Border x:Name="FontColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="White"/>
                                        <Button Name="BtnPickFontColor" Background="Transparent" BorderBrush="Transparent" ToolTip="點擊開啟調色盤" Click="BtnPickFontColor_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 陰影顏色 -->
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="陰影顏色" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="36" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <DrawingGroup>
                                                                <GeometryDrawing Brush="#CCCCCC">
                                                                    <GeometryDrawing.Geometry>
                                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                                <GeometryDrawing Brush="#FFFFFF">
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <RectangleGeometry Rect="0,0,4,4"/>
                                                                            <RectangleGeometry Rect="4,4,4,4"/>
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingGroup>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <Border x:Name="ShadowColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="Black"/>
                                        <Button Name="BtnPickShadowColor" Background="Transparent" BorderBrush="Transparent" ToolTip="點擊開啟調色盤" Click="BtnPickShadowColor_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 外框顏色 -->
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="外框顏色" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="36" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <DrawingGroup>
                                                                <GeometryDrawing Brush="#CCCCCC">
                                                                    <GeometryDrawing.Geometry>
                                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                                <GeometryDrawing Brush="#FFFFFF">
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <RectangleGeometry Rect="0,0,4,4"/>
                                                                            <RectangleGeometry Rect="4,4,4,4"/>
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingGroup>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <Border x:Name="BorderColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="Black"/>
                                        <Button Name="BtnPickBorderColor" Background="Transparent" BorderBrush="Transparent" ToolTip="點擊開啟調色盤" Click="BtnPickBorderColor_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 背景顏色 -->
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="背景顏色" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                    <Grid Height="36" Cursor="Hand">
                                        <Border CornerRadius="4" BorderBrush="#888" BorderThickness="1" ClipToBounds="True">
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <DrawingGroup>
                                                                <GeometryDrawing Brush="#CCCCCC">
                                                                    <GeometryDrawing.Geometry>
                                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                                <GeometryDrawing Brush="#FFFFFF">
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <RectangleGeometry Rect="0,0,4,4"/>
                                                                            <RectangleGeometry Rect="4,4,4,4"/>
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingGroup>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <Border x:Name="BgColorSwatch" CornerRadius="4" BorderBrush="#888" BorderThickness="1" Background="Transparent"/>
                                        <Button Name="BtnPickBgColor" Background="Transparent" BorderBrush="Transparent" ToolTip="點擊開啟調色盤（透明 = A 設為 0）" Click="BtnPickBgColor_Click"/>
                                    </Grid>
                                </StackPanel>

                            </UniformGrid>

                            <!-- 外框寬度 -->
                            <TextBlock Text="外框寬度（Border Width）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider Name="SliderStroke" Minimum="0" Maximum="10" Value="0"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="StyleControl_SliderChanged"/>
                                <TextBlock Grid.Column="1" Name="LblStrokeValue" Text="0"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="Bold"/>
                            </Grid>

                            <!-- 位置設定 -->
                            <TextBlock Text="字卡位置（Position）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Name="ComboPosition" Margin="0,0,0,10"
                                      SelectionChanged="StyleControl_Changed">
                                <ComboBoxItem Content="底部置中（Bottom Center）" IsSelected="True"/>
                                <ComboBoxItem Content="頂部置中（Top Center）"/>
                                <ComboBoxItem Content="中央置中（Middle Center）"/>
                                <ComboBoxItem Content="底部靠左（Bottom Left）"/>
                                <ComboBoxItem Content="底部靠右（Bottom Right）"/>
                            </ComboBox>

                            <!-- 拖曳座標顯示 -->
                            <UniformGrid Columns="2" Margin="0,4,0,10">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="X 座標（px）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtPosX" Text="0" Padding="5"
                                             IsReadOnly="True" Background="#F0F0F0"
                                             ToolTip="拖曳字卡後自動更新"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="Y 座標（px）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtPosY" Text="0" Padding="5"
                                             IsReadOnly="True" Background="#F0F0F0"
                                             ToolTip="拖曳字卡後自動更新"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- 字卡時間設定 -->
                            <Separator Margin="0,5,0,10"/>
                            <TextBlock Text="⏱ 字卡時間設定" FontWeight="Bold" FontSize="13"
                                       Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="開始時間（秒）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtSubStartTime" Text="0" Padding="5"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="顯示時長（秒）：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtSubDuration" Text="5" Padding="5"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- 動作按鈕 -->
                            <Separator Margin="0,5,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="➕ 套用字卡至時間軸"
                                        Padding="8,10" Background="#007ACC" Foreground="White"
                                        BorderBrush="{x:Null}" Margin="0,0,5,0"
                                        FontWeight="SemiBold"
                                        Click="BtnAddText_Click"/>
                                <Button Grid.Column="1" Content="💾 更新選取字卡樣式"
                                        Padding="8,10" Background="#5A8A3E" Foreground="White"
                                        BorderBrush="{x:Null}" Margin="5,0,0,0"
                                        FontWeight="SemiBold"
                                        Click="BtnUpdateStyle_Click"/>
                            </Grid>

                            <Button Content="👁 即時預覽字卡效果"
                                    Margin="0,8,0,0" Padding="8,10"
                                    Background="#5A3E8A" Foreground="White"
                                    BorderBrush="{x:Null}" FontWeight="SemiBold"
                                    Click="BtnPreviewSubtitle_Click"/>

                            <!-- 即時預覽縮圖 -->
                            <Border Margin="0,12,0,0" Background="#111" CornerRadius="6"
                                    Height="80" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="字卡預覽" Foreground="#555"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12"/>
                                    <Border Name="MiniPreviewBorder" CornerRadius="3" Padding="8,3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Name="TxtMiniPreview"
                                                   Text="字卡預覽文字" Foreground="White"
                                                   FontSize="14" FontFamily="Microsoft JhengHei"/>
                                    </Border>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 影像剪輯頁 ===== -->
                <TabItem Header="✂️ 影像剪輯 (F2)" FontSize="14">
                    <StackPanel Margin="15">
                        <TextBlock Text="✂️ 剪輯設定面板" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                        <TextBlock Text="設定剪輯保留區間：" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="開始時間 (秒)：" VerticalAlignment="Center" Width="100"/>
                            <TextBox Name="TxtStartTime" Width="70" Text="0" 
                                     VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="結束時間 (秒)：" VerticalAlignment="Center" Width="100"/>
                            <TextBox Name="TxtEndTime" Width="70" Text="10" 
                                     VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>

                        <Button Name="BtnTrim" Content="設定剪輯標記" Padding="10"
                                Background="#007ACC" Foreground="White" BorderBrush="{x:Null}"
                                Click="BtnTrim_Click"/>
                    </StackPanel>
                </TabItem>

                <!-- ===== 畫面調整頁 ===== -->
                <TabItem Header="🎨 畫面調整 (F3)" FontSize="14">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="此區塊未來可放置亮度、對比、濾鏡等設定..." 
                                   Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- ===== 時間軸區域 ===== -->
        <Border Grid.Row="2" Background="#252526" Margin="10,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2D2D2D">
                    <Button Name="BtnPlay" Content="▶ 播放" Margin="5" Padding="15,2" 
                            Background="#4CAF50" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="BtnPlay_Click"/>
                    <Button Name="BtnPause" Content="⏸ 暫停" Margin="0,5,15,5" Padding="15,2" 
                            Background="#FF9800" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="BtnPause_Click"/>

                    <RadioButton Name="RadioSelect" Content="🏹 選取 (V)" IsChecked="True" 
                                 Margin="5" Foreground="White" VerticalAlignment="Center" 
                                 Checked="ToolRadioButton_Checked" Tag="Select"/>
                    <RadioButton Name="RadioScissors" Content="✂️ 剪刀 (C)" 
                                 Margin="5" Foreground="White" VerticalAlignment="Center" 
                                 Checked="ToolRadioButton_Checked" Tag="Scissors"/>
                    <Button x:Name="BtnDelete" Content="✖ 刪除 (Del)" 
                            Click="BtnDelete_Click" 
                            Margin="10,5,5,5" Padding="10,0" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand"/>
                    <Button x:Name="BtnUndo" Content="↩ 撤銷 (Ctrl+Z)" 
                            Click="BtnUndo_Click" 
                            Margin="5,5,5,5" Padding="10,0" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" ToolTip="復原上一個動作"/>
                    <Button x:Name="BtnRedo" Content="↪ 重作 (Ctrl+Y)" 
                            Click="BtnRedo_Click" 
                            Margin="5,5,10,5" Padding="10,0" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" ToolTip="重做上一個動作"/>
                    <Separator Margin="0,5,0,5" Background="#555"/>
                    <Button x:Name="BtnCut" Content="✂ 剪下 (Ctrl+X)"
                            Click="BtnCut_Click"
                            Margin="5,5,5,5" Padding="10,0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="剪下選取的元素"/>
                    <Button x:Name="BtnCopy" Content="⎘ 複製 (Ctrl+C)"
                            Click="BtnCopy_Click"
                            Margin="5,5,5,5" Padding="10,0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="複製選取的元素"/>
                    <Button x:Name="BtnPaste" Content="📋 貼上 (Ctrl+V)"
                            Click="BtnPaste_Click"
                            Margin="5,5,10,5" Padding="10,0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="貼上至游標右方"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" x:Name="TimelineScrollViewer" 
                              PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Background="Transparent" 
                                MouseDown="VideoTrackCanvas_MouseDown">

                        <Grid Name="TimelineContentStack">
                            <StackPanel Orientation="Vertical">

                                <Grid Height="25" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Grid.Column="1" Name="TimeRulerCanvas" 
                    Background="#2D2D2D" HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Height="40" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="207*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#AAAAFF"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="10">
                                        <TextBlock.Text>💬 字卡軌 1</TextBlock.Text>
                                    </TextBlock>
                                    <Canvas Grid.Column="1" Name="SubtitleTrackCanvas0"
                    Background="#1A1A2E" HorizontalAlignment="Left"
                    Grid.ColumnSpan="3"/>
                                </Grid>

                                <Grid Height="40" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="207*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#AAAADD"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="10">
                                        <TextBlock.Text>💬 字卡軌 2</TextBlock.Text>
                                    </TextBlock>
                                    <Canvas Grid.Column="1" Name="SubtitleTrackCanvas1"
                    Background="#1A2035" HorizontalAlignment="Left"
                    Grid.ColumnSpan="3"/>
                                </Grid>

                                <Grid Height="40" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="207*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#AADDAA"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="10">
                                        <TextBlock.Text>💬 字卡軌 3</TextBlock.Text>
                                    </TextBlock>
                                    <Canvas Grid.Column="1" Name="SubtitleTrackCanvas2"
                    Background="#1A2A1E" HorizontalAlignment="Left"
                    Grid.ColumnSpan="3"/>
                                </Grid>

                                <Grid Height="80" Margin="0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="207*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎬 影像軌" Foreground="White" 
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="11"/>
                                    <Canvas Grid.Column="1" Name="VideoTrackCanvas" 
                    Background="#1E1E1E" HorizontalAlignment="Left" 
                    Grid.ColumnSpan="3"/>
                                </Grid>

                                <Grid Height="35" Margin="0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="207*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎵 音訊軌" Foreground="White" 
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="11"/>
                                    <Canvas Grid.Column="1" Name="AudioTrackCanvas" 
                    Background="#1A281E" HorizontalAlignment="Left" 
                    Grid.ColumnSpan="3"/>
                                </Grid>

                            </StackPanel>

                            <Canvas Name="PlayheadCanvas" IsHitTestVisible="False" 
                                    Margin="80,0,0,0" Panel.ZIndex="10">
                                <Line x:Name="PlayheadLine" 
                                      X1="0" Y1="0" X2="0" Y2="273"
                                      Stroke="Red" StrokeThickness="2" 
                                      Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <!-- ===== 調色盤 Popup（置於 Window 根層，避免 NameScope 隔離與視覺樹問題）===== -->
        <Popup x:Name="PopupFontColor" StaysOpen="False"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnPickFontColor}">
            <local:ColorPickerPopup x:Name="PickerFontColor"/>
        </Popup>

        <Popup x:Name="PopupShadowColor" StaysOpen="False"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnPickShadowColor}">
            <local:ColorPickerPopup x:Name="PickerShadowColor"/>
        </Popup>

        <Popup x:Name="PopupBorderColor" StaysOpen="False"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnPickBorderColor}">
            <local:ColorPickerPopup x:Name="PickerBorderColor"/>
        </Popup>

        <Popup x:Name="PopupBgColor" StaysOpen="False"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnPickBgColor}">
            <local:ColorPickerPopup x:Name="PickerBgColor"/>
        </Popup>
    </Grid>
</Window>