<Window x:Class="framework.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="影片匯出設定" Height="500" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- 格式選擇按鈕（對應 ToolButtonStyle，但適合淺色背景） -->
        <Style x:Key="FormatBtn" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Format"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#EFEFEF" BorderBrush="#CCCCCC"
                                BorderThickness="1" CornerRadius="4" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0069B3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0069B3"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 主要內容 ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,20,22,8">

                <TextBlock Text="影片匯出設定" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>

                <!-- 格式 -->
                <TextBlock Text="格式" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <UniformGrid Columns="3">
                    <RadioButton Name="RadioFormatMP4" IsChecked="True" Style="{StaticResource FormatBtn}" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="MP4" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="通用格式" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="#CCE8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Name="RadioFormatMKV" Style="{StaticResource FormatBtn}" Margin="2,0,3,0">
                        <StackPanel>
                            <TextBlock Text="MKV" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="多軌道" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="#CCE8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Name="RadioFormatMOV" Style="{StaticResource FormatBtn}" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="MOV" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Apple 裝置" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="#CCE8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <TextBlock Text="MP4 相容性最廣，適合大多數用途" FontSize="10" Foreground="#999999" Margin="0,5,0,0"/>

                <Separator Margin="0,16,0,16"/>

                <!-- 輸出品質 -->
                <TextBlock Text="輸出品質" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12,8">
                    <StackPanel>

                        <RadioButton Name="RadioLow" GroupName="Quality" Margin="0,0,0,10"
                                     HorizontalContentAlignment="Stretch" Checked="RadioQuality_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="快速" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="較小檔案，適合草稿或快速分享" FontSize="10" Foreground="#666666" Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="1 Mbps" FontSize="10" Foreground="#999999" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton Name="RadioMedium" GroupName="Quality" IsChecked="True" Margin="0,0,0,10"
                                     HorizontalContentAlignment="Stretch" Checked="RadioQuality_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="標準" FontWeight="SemiBold" FontSize="12"/>
                                        <Border Background="#007ACC" CornerRadius="2" Padding="4,0" Margin="6,1,0,0">
                                            <TextBlock Text="推薦" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="品質與檔案大小的最佳平衡" FontSize="10" Foreground="#666666" Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="2 Mbps" FontSize="10" Foreground="#999999" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton Name="RadioHigh" GroupName="Quality" Margin="0,0,0,10"
                                     HorizontalContentAlignment="Stretch" Checked="RadioQuality_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="高品質" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="最佳畫質，適合最終成品或長期存檔" FontSize="10" Foreground="#666666" Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="4 Mbps" FontSize="10" Foreground="#999999" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton Name="RadioCustom" GroupName="Quality"
                                     HorizontalContentAlignment="Stretch" Checked="RadioQuality_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自訂碼率" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Name="TxtBitrate" Width="65" Text="2000" Padding="5,3"
                                             IsEnabled="{Binding IsChecked, ElementName=RadioCustom}"
                                             TextChanged="TxtBitrate_TextChanged"/>
                                    <TextBlock Text="kbps" FontSize="10" Foreground="#666666"
                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                    </StackPanel>
                </Border>

                <Separator Margin="0,16,0,0"/>

                <!-- 進階設定 -->
                <Expander Header="進階設定" Margin="0,8,0,0" FontSize="12">
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                            Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>

                            <!-- 視訊 / 音訊 編碼 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="視訊" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox Name="ComboVideoCodec" Grid.Column="1" Height="26" FontSize="12"
                                          SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="H264"/>
                                    <ComboBoxItem Content="H265"/>
                                    <ComboBoxItem Content="VP9"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="音訊" FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <ComboBox Name="ComboAudioCodec" Grid.Column="3" Height="26" FontSize="12"
                                          SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="AAC"/>
                                    <ComboBoxItem Content="MP3"/>
                                </ComboBox>
                            </Grid>

                            <!-- 解析度 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="解析度" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Name="TxtWidth" Grid.Column="1" Width="60" Text="" Padding="5,3" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="×" Margin="6,0" VerticalAlignment="Center" Foreground="#999999"/>
                                <TextBox Name="TxtHeight" Grid.Column="3" Width="60" Text="" Padding="5,3" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="留空以保持原始尺寸" FontSize="10"
                                           Foreground="#999999" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 網路最佳化 -->
                            <CheckBox Name="ChkFastStart" FontSize="12">
                                <TextBlock>
                                    <Run Text="網路串流最佳化" FontWeight="SemiBold"/>
                                    <Run Text=" — 讓影片在網路上更快開始播放" Foreground="#666666"/>
                                </TextBlock>
                            </CheckBox>

                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 頁尾 ── -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <TextBlock Name="LblSizeEstimate" VerticalAlignment="Center"
                           FontSize="11" Foreground="#999999"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="BtnCancel" Content="取消" Width="75" Padding="10,5"
                            Background="#F0F0F0" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Name="BtnConfirm" Content="開始匯出" Padding="15,5"
                            Background="#007ACC" Foreground="White" BorderBrush="{x:Null}"
                            FontWeight="SemiBold" Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
